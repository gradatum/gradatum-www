    margin-top: 1rem;
    line-height: 1.1;
  }

  .qs-muted {
    color: var(--muted);
  }

  .qs-blocks {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-top: 2.5rem;
  }

  .qs-block {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .block-label {
    letter-spacing: 0.15em;
  }

  .qs-pre {
    flex: 1;
    border-left: 3px solid var(--accent);
    font-size: 0.8125rem;
    overflow-x: auto;
